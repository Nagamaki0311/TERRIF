[
  { "id": "p-20261031-0001", "at": "2026-10-31T03:20:00+09:00", "text": "ホームページをつくりはじめた。平成のころの、手作りの感じを思い出しながら。" },
  { "id": "p-20261031-0002", "at": "2026-10-31T03:24:10+09:00", "text": "ちくわパンが食べたい。" },
  { "id": "p-20261031-0003", "at": "2026-10-31T03:31:42+09:00", "text": "ここに置いた言葉は、ふせんみたいに積もっていく。ドラッグして動かせるので、遊んでいってください。" },
  { "id": "p-20261031-0004", "at": "2026-10-31T03:40:05+09:00", "text": "夜ふかし。" },
  { "id": "p-20261031-0005", "at": "2026-10-31T03:52:33+09:00", "text": "版ズレした印刷物って、なんでこんなに落ち着くんだろう。" }
]
